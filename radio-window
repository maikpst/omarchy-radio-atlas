#!/usr/bin/env bash
# Upstream legt beim Öffnen eine benannte Float-Regel mit fester Größe an.
# Die wird nach den statischen Regeln registriert und überschreibt sie.
# Hier nur abschalten: das Fenster bleibt gekachelt und füllt die Arbeitsfläche.
set -euo pipefail

width=${1:-}
height=${2:-}

[[ $width =~ ^[0-9]+$ && $height =~ ^[0-9]+$ ]] || {
  echo "usage: radio-window WIDTH HEIGHT" >&2
  exit 2
}

[[ $(hyprctl -j status | jq -r '.configProvider // ""') == lua ]] || exit 2

read -r -d '' setup <<'LUA' || true
if _G.omarchy_radio_atlas_window_handler then
  _G.omarchy_radio_atlas_window_handler:remove()
  _G.omarchy_radio_atlas_window_handler = nil
end

if _G.omarchy_radio_atlas_window_rule then
  _G.omarchy_radio_atlas_window_rule:set_enabled(false)
  _G.omarchy_radio_atlas_window_rule = nil
end
LUA

response=$(hyprctl eval "$setup")
[[ $response == ok ]] || {
  echo "$response" >&2
  exit 1
}
