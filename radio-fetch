#!/usr/bin/env bash
set -euo pipefail
umask 077

: "${XDG_RUNTIME_DIR:?Radio Atlas requires XDG_RUNTIME_DIR}"
runtime_dir="$XDG_RUNTIME_DIR/omarchy-radio-atlas"
cache_root=${XDG_CACHE_HOME:-$HOME/.cache}
cache_dir="$cache_root/omarchy-radio-atlas"
country_cache_dir="$cache_dir/countries"
install -d -m 700 "$runtime_dir" "$cache_dir" "$country_cache_dir"

world_file="$runtime_dir/world.json"
world_cache_file="$cache_dir/world.json"
results_file="$runtime_dir/results.json"
script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
state_path="$script_dir/radio-state"
version=$(jq -r '.version' "$script_dir/manifest.json")
user_agent="Radio Atlas/$version (https://github.com/AksharP5/omarchy-radio-atlas)"
max_response_bytes=4194304
world_cache_minutes=1440
country_cache_minutes=1440
search_dir=""
world_more_response=""
world_more_result=""
request_dir=""
bases=()

cleanup() {
  [[ -z $search_dir ]] || rm -rf "$search_dir"
  [[ -z $world_more_response ]] || rm -f "$world_more_response"
  [[ -z $world_more_result ]] || rm -f "$world_more_result"
  [[ -z $request_dir ]] || rm -rf -- "$request_dir"
}
trap cleanup EXIT
request_dir=$(mktemp -d "$runtime_dir/fetch.XXXXXX")

discover_bases() {
  local ip hostname
  while read -r ip; do
    hostname=$(getent hosts "$ip" 2>/dev/null | awk 'NR == 1 { print $2 }')
    if [[ $hostname =~ ^[A-Za-z0-9.-]+\.api\.radio-browser\.info$ ]]; then
      printf 'https://%s\n' "$hostname"
    fi
  done < <(getent ahostsv4 all.api.radio-browser.info 2>/dev/null \
    | awk '!seen[$1]++ { print $1 }')

}

load_bases() {
  (( ${#bases[@]} > 0 )) && return
  mapfile -t bases < <(discover_bases | awk '!seen[$0]++' | shuf)
  if (( ${#bases[@]} == 0 )); then
    bases=('https://all.api.radio-browser.info')
  fi
}

normalize='def number_or_null: try tonumber catch null;
  def clean($limit):
    if type == "string"
    then gsub("[\\r\\n\\t]"; " ") | gsub("  +"; " ") | .[0:$limit]
    else ""
    end;
  def compact($limit):
    if type == "string" then gsub("[\\r\\n\\t]"; "") | .[0:$limit] else "" end;
  .[:500]
  | map({
    uuid: ((.stationuuid // "") | compact(64)),
    name: (((.name // "Unknown station") | clean(160)) as $name
      | if $name == "" then "Unknown station" else $name end),
    url: ((.url_resolved | compact(2048)) as $resolved
      | if $resolved == "" then (.url | compact(2048)) else $resolved end),
    homepage: ((.homepage // "") | compact(2048)),
    favicon: ((.favicon // "") | compact(2048)),
    country: ((.country // "") | clean(100)),
    countryCode: ((.countrycode // "") | clean(2) | ascii_upcase),
    state: ((.state // "") | clean(100)),
    language: ((.language // "") | clean(120)),
    tags: ((.tags // "") | clean(500)),
    codec: ((.codec // "") | clean(32)),
    bitrate: ((.bitrate // 0) | number_or_null // 0),
    votes: ((.votes // 0) | number_or_null // 0),
    clicks: ((.clickcount // 0) | number_or_null // 0),
    latitude: ((.geo_lat // null) | number_or_null),
    longitude: ((.geo_long // null) | number_or_null)
  })
  | map(select(
      .uuid != ""
      and (.url | test("^https?://"; "i"))
      and (.latitude == null or (.latitude >= -90 and .latitude <= 90))
      and (.longitude == null or (.longitude >= -180 and .longitude <= 180))
    ))
  | reduce .[] as $station ({seen: {}, rows: []};
      if .seen[$station.uuid] then .
      else .seen[$station.uuid] = true | .rows += [$station]
      end)
  | .rows[:500]'

request() {
  local max_records=$1
  local path=$2
  shift 2
  load_bases
  local base error_file max_time response_file
  max_time=12
  (( max_records >= 500 )) && max_time=45
  error_file=$(mktemp "$request_dir/request.XXXXXX")
  response_file=$(mktemp "$request_dir/response.XXXXXX")
  for base in "${bases[@]}"; do
    if setpriv --pdeathsig TERM curl --fail --silent --show-error \
      --connect-timeout 4 --max-time "$max_time" \
      --retry 3 --retry-all-errors --retry-delay 0 --retry-max-time "$max_time" \
      --max-filesize "$max_response_bytes" --proto '=https' \
      --user-agent "$user_agent" --get "$base$path" "$@" \
      --output "$response_file" 2>"$error_file" \
      && (( $(stat -c '%s' -- "$response_file") <= max_response_bytes )) \
      && jq -e -s --argjson maxRecords "$max_records" \
        'length == 1 and (.[0] | type == "array" and length <= $maxRecords)' \
        "$response_file" >/dev/null 2>&1; then
      cat "$response_file"
      rm -f "$error_file" "$response_file"
      return 0
    fi
    if [[ ! -s $error_file ]]; then
      printf 'Radio Browser returned invalid station data from %s\n' "$base" > "$error_file"
    fi
  done
  cat "$error_file" >&2
  rm -f "$error_file" "$response_file"
  return 1
}

publish_copy() {
  local source=$1
  local target=$2
  local temporary
  temporary=$(mktemp "${target%/*}/publish.XXXXXX")
  cp "$source" "$temporary"
  mv "$temporary" "$target"
}

valid_world_data() {
  local path=$1
  [[ -s $path ]] \
    && (( $(stat -c '%s' -- "$path") <= max_response_bytes )) \
    && jq -e -s 'length == 1 and (.[0]
      | type == "array" and length > 0 and length <= 500)' \
      "$path" >/dev/null 2>&1
}

valid_country_data() {
  local path=$1
  local code=$2
  [[ -s $path ]] \
    && (( $(stat -c '%s' -- "$path") <= max_response_bytes )) \
    && jq -e -s --arg code "$code" 'length == 1 and (.[0]
      | type == "array" and length <= 25
      and all(.[]; (.countryCode // "") == $code))' \
      "$path" >/dev/null 2>&1
}

publish_world_cache() {
  publish_copy "$world_cache_file" "$world_file"
  publish_copy "$world_cache_file" "$results_file"
}

store_results() {
  local target=$1
  local temporary
  temporary=$(mktemp "${target%/*}/results.XXXXXX")
  if ! jq -ce "$normalize" > "$temporary" || [[ ! -s $temporary ]]; then
    rm -f "$temporary"
    return 1
  fi
  mv "$temporary" "$target"
  cat "$target"
}

store_random_results() {
  local target=$1
  local exclusions=${2:-}
  local temporary
  store_results "$target" >/dev/null
  temporary=$(mktemp "$runtime_dir/random.XXXXXX")
  jq -c --arg exclusions "$exclusions" '
    ($exclusions | split(",") | map(select(length > 0))
      | map({key: ., value: true}) | from_entries) as $excluded
    | (map(select(
        (.latitude != null and .longitude != null)
        or (.countryCode | test("^[A-Z]{2}$"))
      ))) as $mappable
    | ($mappable | map(select($excluded[.uuid] != true))) as $fresh
    | if ($fresh | length) > 0 then $fresh[] else $mappable[] end
  ' "$target" | shuf | jq -sc . > "$temporary"
  mv "$temporary" "$target"
  cat "$target"
}

refresh_world_cache() {
  request 500 '/json/stations/search' \
    --data-urlencode 'has_geo_info=true' \
    --data-urlencode 'hidebroken=true' \
    --data-urlencode 'order=clickcount' \
    --data-urlencode 'reverse=true' \
    --data-urlencode 'limit=500' \
    | store_results "$world_cache_file" >/dev/null
}

refresh_world_cache_in_background() {
  (
    exec 9>"$cache_dir/world.lock"
    flock -n 9 || exit 0
    request_dir=$(mktemp -d "$runtime_dir/fetch.XXXXXX")
    trap 'rm -rf -- "$request_dir"' EXIT
    refresh_world_cache
  ) </dev/null >/dev/null 2>&1 &
}

refresh_country_cache() {
  local code=$1
  local target=$2
  local temporary
  temporary=$(mktemp "$country_cache_dir/refresh.XXXXXX")
  if request 25 "/json/stations/bycountrycodeexact/$code" \
      --data-urlencode 'hidebroken=true' \
      --data-urlencode 'order=clickcount' \
      --data-urlencode 'reverse=true' \
      --data-urlencode 'limit=25' \
      | store_results "$temporary" >/dev/null \
      && valid_country_data "$temporary" "$code"; then
    mv "$temporary" "$target"
    return
  fi
  rm -f "$temporary"
  return 1
}

refresh_country_cache_in_background() {
  local code=$1
  local target=$2
  (
    exec 9>"$country_cache_dir/$code.lock"
    flock -n 9 || exit 0
    request_dir=$(mktemp -d "$runtime_dir/fetch.XXXXXX")
    trap 'rm -rf -- "$request_dir"' EXIT
    refresh_country_cache "$code" "$target"
  ) </dev/null >/dev/null 2>&1 &
}

publish_country_cache() {
  local source=$1
  publish_copy "$source" "$results_file"
  cat "$source"
}

publish_world_country() {
  local code=$1
  local source=""
  local temporary
  if valid_world_data "$world_cache_file"; then
    source=$world_cache_file
  elif valid_world_data "$world_file"; then
    source=$world_file
  else
    return 1
  fi

  temporary=$(mktemp "$runtime_dir/country.XXXXXX")
  jq -ce --arg code "$code" \
    '[.[] | select((.countryCode // "") == $code)][:100]' \
    "$source" > "$temporary"
  if ! jq -e 'length > 0' "$temporary" >/dev/null; then
    rm -f "$temporary"
    return 1
  fi
  mv "$temporary" "$results_file"
  cat "$results_file"
}

fetch_country() {
  local code=$1
  local country_cache_file="$country_cache_dir/$code.json"
  if valid_country_data "$country_cache_file" "$code"; then
    publish_country_cache "$country_cache_file"
    if ! find "$country_cache_file" -mmin "-$country_cache_minutes" \
      -print -quit | grep -q .; then
      refresh_country_cache_in_background "$code" "$country_cache_file"
    fi
    return
  fi

  if publish_world_country "$code"; then
    refresh_country_cache_in_background "$code" "$country_cache_file"
    return
  fi

  refresh_country_cache "$code" "$country_cache_file"
  publish_country_cache "$country_cache_file"
}

fetch_world() {
  local cache_valid=0
  if valid_world_data "$world_cache_file"; then
    cache_valid=1
  elif valid_world_data "$world_file"; then
    publish_copy "$world_file" "$world_cache_file"
    cache_valid=1
  fi

  if (( cache_valid )); then
    publish_world_cache
    cat "$world_cache_file"
    if ! find "$world_cache_file" -mmin "-$world_cache_minutes" \
      -print -quit | grep -q .; then
      refresh_world_cache_in_background
    fi
    return
  fi

  refresh_world_cache
  publish_world_cache
  cat "$world_cache_file"
}

# Plans the Radio Browser requests for a search: one line per request with
# tab-separated key=value filters. Country, state and language names (also in
# German, accents ignored) become exact filters; "jazz bayern" combines them.
plan_search() {
  python3 -I - "$script_dir/assets" "$1" <<'PY'
import json
import os
import sys
import unicodedata

assets, query = sys.argv[1], sys.argv[2]


def load(name):
    try:
        with open(os.path.join(assets, name)) as source:
            data = json.load(source)
        return data if isinstance(data, dict) else {}
    except Exception as error:  # Lookups are optional; plain search still works.
        print(f"{name} could not be loaded: {error}", file=sys.stderr)
        return {}


def fold(text):
    text = unicodedata.normalize("NFKD", str(text).lower().replace("ß", "ss"))
    return " ".join("".join(c for c in text if not unicodedata.combining(c)).split())


countries = load("country-search.json")
states = load("state-search.json")
languages = load("language-search.json")
query = " ".join(query.split())
raw = query.lower()
folded = fold(query)
plans = []
specific = []


def add(*filters):
    line = "\t".join(f"{key}={value}" for key, value in filters)
    target = specific if len(filters) > 1 or filters[0][0] == "state" else plans
    if line not in plans and line not in specific:
        target.append(line)


def country_of(text):
    code = countries.get(text)
    return code if isinstance(code, str) else ""


def state_of(text):
    entry = states.get(text)
    if isinstance(entry, list) and len(entry) >= 2:
        return str(entry[0]), [str(name) for name in entry[1:3]]
    return None


add(("name", query))
add(("tag", query))
code = country_of(raw) or country_of(folded)
add(("countrycode", code) if code else ("country", query))
language = languages.get(folded, "")
if language:
    add(("language", language))

state = None if code else state_of(folded)
if state:
    for spelling in state[1]:
        add(("state", spelling), ("countrycode", state[0]))

words = folded.split(" ")
if not code and not state and len(words) > 1:
    found = None
    for size in range(len(words) - 1, 0, -1):
        for start in range(0, len(words) - size + 1):
            phrase = " ".join(words[start:start + size])
            match_code = country_of(phrase) if len(phrase) >= 2 else ""
            if match_code and len(phrase) == 2 and 0 < start and start + size < len(words):
                match_code = ""
            match_state = None if match_code or len(phrase) < 3 else state_of(phrase)
            if match_code or match_state:
                found = (match_code, match_state, words[:start] + words[start + size:])
                break
        if found:
            break
    if found:
        match_code, match_state, rest = found
        text = " ".join(rest)
        if match_code:
            add(("name", text), ("countrycode", match_code))
            add(("tag", text), ("countrycode", match_code))
        else:
            for spelling in match_state[1]:
                add(("tag", text), ("state", spelling), ("countrycode", match_state[0]))
            add(("name", text), ("countrycode", match_state[0]))

# Combined filters first: they are the most precise and survive truncation.
print("\n".join(specific + plans))
PY
}

search_request() {
  local filter
  local -a filters arguments=()
  IFS=$'\t' read -r -a filters <<< "$1"
  for filter in "${filters[@]}"; do
    arguments+=(--data-urlencode "$filter")
  done
  request 80 '/json/stations/search' \
    "${arguments[@]}" \
    --data-urlencode 'hidebroken=true' \
    --data-urlencode 'order=clickcount' \
    --data-urlencode 'reverse=true' \
    --data-urlencode 'limit=80'
}

fetch_search() {
  local query=$1
  local plans
  plans=$(plan_search "$query") || plans=""
  if [[ -z $plans ]]; then
    plans=$(printf 'name=%s\ntag=%s\ncountry=%s' "$query" "$query" "$query")
  fi
  load_bases
  search_dir=$(mktemp -d "$runtime_dir/search.XXXXXX")

  local pids=() lines=() index=0 line
  while IFS= read -r line; do
    [[ -n $line ]] || continue
    lines+=("$line")
    search_request "$line" > "$search_dir/$index.json" &
    pids+=("$!")
    index=$(( index + 1 ))
  done <<< "$plans"

  # Mirrors occasionally drop one of several parallel connections; retry a
  # failed request once on its own before giving up on the whole search.
  local failed=0
  for (( i = 0; i < index; i++ )); do
    wait "${pids[$i]}" && continue
    search_request "${lines[$i]}" > "$search_dir/$i.json" || failed=1
  done

  if (( failed )); then
    rm -rf "$search_dir"
    search_dir=""
    echo 'Station service is unavailable' >&2
    return 1
  fi

  local files=()
  for (( i = 0; i < index; i++ )); do files+=("$search_dir/$i.json"); done
  jq -s 'add | reduce .[] as $station ({seen: {}, rows: []};
      ($station.stationuuid // "") as $id
      | if $id != "" and .seen[$id] then .
        else .seen[$id] = true | .rows += [$station] end) | .rows' "${files[@]}" \
    | store_results "$results_file"
  rm -rf "$search_dir"
  search_dir=""
}

fetch_world_more() {
  world_more_response=$(mktemp "$runtime_dir/world-more-response.XXXXXX")
  world_more_result=$(mktemp "$runtime_dir/world-more-result.XXXXXX")
  if request 500 '/json/stations/search' \
      --data-urlencode 'hidebroken=true' \
      --data-urlencode 'order=random' \
      --data-urlencode 'limit=500' > "$world_more_response" \
      && store_results "$world_more_result" < "$world_more_response"; then
    rm -f "$world_more_response" "$world_more_result"
    world_more_response=""
    world_more_result=""
    return
  fi
  rm -f "$world_more_response" "$world_more_result"
  world_more_response=""
  world_more_result=""
  return 1
}

resolve_stations() {
  local uuids=$1
  [[ $uuids =~ ^[0-9A-Fa-f-]{20,}(,[0-9A-Fa-f-]{20,})*$ ]] \
    || { echo 'Invalid station ids' >&2; exit 2; }
  (( ${#uuids} <= 4096 )) || { echo 'Too many station ids' >&2; exit 2; }

  local commas=${uuids//[^,]/}
  request "$(( ${#commas} + 1 ))" '/json/stations/byuuid' \
    --data-urlencode "uuids=$uuids" \
    | jq -c "$normalize"
}

action=${1:-world}
case "$action" in
  world)
    fetch_world
    ;;
  country)
    code=${2:-}
    [[ $code =~ ^[A-Za-z]{2}$ ]] || { echo 'Country code must contain two letters' >&2; exit 2; }
    fetch_country "${code^^}"
    ;;
  search)
    query=${2:-}
    [[ -n ${query//[[:space:]]/} ]] || { echo 'Search text is empty' >&2; exit 2; }
    (( ${#query} <= 128 )) || { echo 'Search text is too long' >&2; exit 2; }
    fetch_search "$query"
    ;;
  world-more)
    fetch_world_more
    ;;
  random)
    exclusions=${2:-}
    if [[ -n $exclusions ]]; then
      [[ $exclusions =~ ^[0-9A-Fa-f-]{20,64}(,[0-9A-Fa-f-]{20,64})*$ ]] \
        || { echo 'Invalid excluded station ids' >&2; exit 2; }
      (( ${#exclusions} <= 4096 )) || { echo 'Too many excluded station ids' >&2; exit 2; }
    fi
    saved_exclusions=$("$state_path" get 2>/dev/null | jq -r '
      [.recent[]?.uuid
        | select(type == "string" and length >= 20 and length <= 64)
        | select(test("^[0-9A-Fa-f-]+$"))][:30]
      | join(",")
    ' 2>/dev/null || true)
    exclusions=$(jq -nr --arg requested "$exclusions" --arg saved "$saved_exclusions" '
      [$requested, $saved] | map(split(",")) | add
      | map(select(length > 0)) | unique | join(",")
    ')
    (( ${#exclusions} <= 4096 )) || { echo 'Too many excluded station ids' >&2; exit 2; }
    request 60 '/json/stations/search' \
      --data-urlencode 'hidebroken=true' \
      --data-urlencode 'order=random' \
      --data-urlencode 'limit=60' \
      | store_random_results "$results_file" "$exclusions"
    ;;
  resolve)
    resolve_stations "${2:-}"
    ;;
  *)
    echo "Unknown action: $action" >&2
    exit 2
    ;;
esac
